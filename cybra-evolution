#!/data/data/com.termux/files/usr/bin/bash

# CYBRA FULL EVOLUTION MODE v1

STATE_FILE=".cybra_evolution_state"
INDEX_FILE=".cybra_module_index"

IGNORE="node_modules .git"

hash_state() {
    find . -type f \
    $(for i in $IGNORE; do echo "! -path './$i/*'"; done) \
    -exec sha256sum {} \; 2>/dev/null | sha256sum | awk '{print $1}'
}

build_module_index() {
    echo "🧠 Building evolution module index..."

    rm -f "$INDEX_FILE"

    find . -type f \( -name "*.js" -o -name "*.mjs" -o -name "*.sh" \) | while read file; do

        content=$(cat "$file" 2>/dev/null)

        tag="[GENERIC]"

        # 🔍 SIMPLE CODE INTELLIGENCE (not AI, but structural heuristics)
        if echo "$file $content" | grep -qi "bot\|telegram\|message"; then
            tag="[AI][BOT]"
        elif echo "$file $content" | grep -qi "api\|fetch\|axios"; then
            tag="[CORE][API]"
        elif echo "$file $content" | grep -qi "nfc\|device\|usb"; then
            tag="[DEVICE][NFC]"
        elif echo "$file $content" | grep -qi "pay\|kyber\|bank"; then
            tag="[FIN][PAYMENT]"
        elif echo "$file $content" | grep -qi "trade\|crypto\|order"; then
            tag="[FIN][TRADING]"
        fi

        echo "$file $tag" >> "$INDEX_FILE"
    done

    echo "✅ Module index built"
}

show_diff() {
    echo "📊 Evolution changes:"
    git diff --cached --name-status | while read status file; do
        case "$status" in
            A) echo "➕ added: $file" ;;
            M) echo "✏️ modified: $file" ;;
            D) echo "❌ deleted: $file" ;;
        esac
    done
}

run_evolution() {

    echo "🧬 CYBRA FULL EVOLUTION MODE START"

    CURRENT_HASH=$(hash_state)
    LAST_HASH=""

    [ -f "$STATE_FILE" ] && LAST_HASH=$(cat "$STATE_FILE")

    if [ "$CURRENT_HASH" == "$LAST_HASH" ]; then
        echo "⚠️ No structural evolution detected"
        exit 0
    fi

    build_module_index

    git add .

    if git diff --cached --quiet; then
        echo "⚠️ Nothing to commit"
        exit 0
    fi

    echo ""
    show_diff
    echo ""

    COMMIT_MSG="evolution snapshot: $CURRENT_HASH"

    git commit -m "$COMMIT_MSG"

    echo "$CURRENT_HASH" > "$STATE_FILE"

    git push origin main

    echo "🚀 EVOLUTION SAVED"
    echo "🧾 Snapshot: $CURRENT_HASH"
}

case "$1" in
    run)
        run_evolution
        ;;
    index)
        build_module_index
        ;;
    *)
        echo "CYBRA EVOLUTION MODE"
        echo "Usage:"
        echo "  cybra-evolution run   → full snapshot evolution"
        echo "  cybra-evolution index → build module map"
        ;;
esac
