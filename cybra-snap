#!/data/data/com.termux/files/usr/bin/bash

# CYBRA SNAPSHOT ENGINE

STATE_FILE=".cybra_state"
IGNORE_PATTERNS="node_modules .git *.log *.tmp"

get_hash() {
    find . -type f \
    $(printf "! -path './%s/*' " $IGNORE_PATTERNS) \
    -exec sha256sum {} \; 2>/dev/null | sha256sum | awk '{print $1}'
}

current_hash=$(get_hash)

last_hash=""

if [ -f "$STATE_FILE" ]; then
    last_hash=$(cat "$STATE_FILE")
fi

if [ "$current_hash" == "$last_hash" ]; then
    echo "⚠️ No changes detected (same snapshot)"
    exit 0
fi

echo "📦 New snapshot detected"

git add .

if git diff --cached --quiet; then
    echo "⚠️ Nothing to commit"
    exit 0
fi

git commit -m "snapshot: $current_hash"

echo "$current_hash" > "$STATE_FILE"

git push origin main

echo "✅ Snapshot saved: $current_hash"
