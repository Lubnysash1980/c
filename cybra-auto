#!/data/data/com.termux/files/usr/bin/bash

# CYBRA AUTONOMOUS DEVOPS SYSTEM

CONFIG="$HOME/.cybra_config"
PIDFILE="$HOME/.cybra_pid"
STATE="$HOME/.cybra_state"

load_config() {
    [ -f "$CONFIG" ] || { echo "❌ Run: cybra-auto init"; exit 1; }
    source "$CONFIG"
}

save_config() {
    echo "USER=$USER_NAME" > "$CONFIG"
    echo "TOKEN=$TOKEN" >> "$CONFIG"
    echo "REPO=$REPO" >> "$CONFIG"
}

init() {
    echo "👤 GitHub username:"
    read USER_NAME

    echo "🔐 GitHub token:"
    read TOKEN

    echo "📦 Repo name:"
    read REPO

    save_config
    echo "✅ Config saved"
}

ensure_git() {
    [ -d ".git" ] || git init
    git branch -M main

    git remote remove origin 2>/dev/null
    git remote add origin https://github.com/$USER/$REPO.git 2>/dev/null
}

hash_state() {
    find . -type f \
    -not -path "./node_modules/*" \
    -not -path "./.git/*" \
    -exec sha256sum {} \; 2>/dev/null | sha256sum | awk '{print $1}'
}

sync() {
    git add .

    if git diff --cached --quiet; then
        return
    fi

    HASH=$(hash_state)

    LAST=""
    [ -f "$STATE" ] && LAST=$(cat "$STATE")

    [ "$HASH" = "$LAST" ] && return

    git commit -m "auto: $HASH"

    git push https://$USER:$TOKEN@github.com/$USER/$REPO.git main

    echo "$HASH" > "$STATE"

    echo "🚀 synced: $HASH"
}

daemon_loop() {
    echo "🧬 CYBRA AUTONOMOUS RUNNING..."

    while true; do
        ensure_git
        sync
        sleep 5
    done
}

start() {
    load_config

    if [ -f "$PIDFILE" ]; then
        echo "⚠️ Already running"
        exit 0
    fi

    nohup bash -c "daemon_loop" >/dev/null 2>&1 &
    echo $! > "$PIDFILE"

    echo "✅ Started (PID $(cat $PIDFILE))"
}

stop() {
    if [ -f "$PIDFILE" ]; then
        kill $(cat "$PIDFILE") 2>/dev/null
        rm -f "$PIDFILE"
        echo "🛑 Stopped"
    else
        echo "⚠️ Not running"
    fi
}

status() {
    if [ -f "$PIDFILE" ]; then
        echo "✅ Running (PID $(cat $PIDFILE))"
    else
        echo "❌ Not running"
    fi
}

update() {
    echo "🔄 Updating..."
    curl -s -o $PREFIX/bin/cybra-auto https://raw.githubusercontent.com/$USER/$REPO/main/cybra-auto
    chmod +x $PREFIX/bin/cybra-auto
    echo "✅ Updated"
}

case "$1" in
    init) init ;;
    start) start ;;
    stop) stop ;;
    status) status ;;
    update) load_config; update ;;
    *) 
        echo "CYBRA AUTO"
        echo "init | start | stop | status | update"
        ;;
esac
