#!/data/data/com.termux/files/usr/bin/bash

# CYBRA CLUSTER AI MODE

BASE="$HOME/.cybra_cluster"
PROJECTS="$BASE/projects.list"
STATE_DIR="$BASE/state"
META_DIR="$BASE/meta"
PIDFILE="$BASE/pid"

mkdir -p "$BASE" "$STATE_DIR" "$META_DIR"

load_config() {
    source "$HOME/.cybra_config" 2>/dev/null || {
        echo "❌ Run: cybra-auto init first"
        exit 1
    }
}

add_project() {
    echo "📂 Path:"
    read path

    echo "📦 Repo:"
    read repo

    echo "⚡ Priority (1=high, 2=normal, 3=low):"
    read prio

    echo "$path|$repo|$prio" >> "$PROJECTS"

    echo "✅ Added"
}

hash_project() {
    find "$1" -type f \
    -not -path "*/node_modules/*" \
    -not -path "*/.git/*" \
    -exec sha256sum {} \; 2>/dev/null | sha256sum | awk '{print $1}'
}

get_last_push_time() {
    file="$META_DIR/$1.time"
    [ -f "$file" ] && cat "$file" || echo 0
}

set_last_push_time() {
    echo $(date +%s) > "$META_DIR/$1.time"
}

should_sync() {
    repo="$1"
    prio="$2"

    now=$(date +%s)
    last=$(get_last_push_time "$repo")

    diff=$((now - last))

    case "$prio" in
        1) threshold=5 ;;   # high priority
        2) threshold=15 ;;  # normal
        3) threshold=40 ;;  # low
        *) threshold=20 ;;
    esac

    [ "$diff" -gt "$threshold" ]
}

sync_project() {
    path="$1"
    repo="$2"
    prio="$3"

    cd "$path" || return

    [ -d ".git" ] || git init
    git branch -M main

    git remote remove origin 2>/dev/null
    git remote add origin https://github.com/$USER/$repo.git 2>/dev/null

    git add .

    if git diff --cached --quiet; then
        return
    fi

    HASH=$(hash_project "$path")

    STATE_FILE="$STATE_DIR/$repo"

    LAST=""
    [ -f "$STATE_FILE" ] && LAST=$(cat "$STATE_FILE")

    [ "$HASH" = "$LAST" ] && return

    if ! should_sync "$repo" "$prio"; then
        return
    fi

    # 🧠 AI-style commit message
    COUNT=$(git diff --cached --name-only | wc -l)

    MSG="ai-cluster[$prio]: $COUNT files → $HASH"

    git commit -m "$MSG"

    git push https://$USER:$TOKEN@github.com/$USER/$repo.git main

    echo "$HASH" > "$STATE_FILE"
    set_last_push_time "$repo"

    echo "🚀 [$repo] synced ($COUNT files)"
}

cluster_loop() {
    echo "🧠 CYBRA CLUSTER AI MODE RUNNING..."

    while true; do

        while IFS="|" read -r path repo prio; do
            [ -z "$path" ] && continue
            sync_project "$path" "$repo" "$prio"
        done < "$PROJECTS"

        sleep 3
    done
}

start() {
    load_config

    if [ -f "$PIDFILE" ]; then
        echo "⚠️ Already running"
        exit 0
    fi

    nohup bash -c "cluster_loop" >/dev/null 2>&1 &
    echo $! > "$PIDFILE"

    echo "🧬 AI Cluster started"
}

stop() {
    [ -f "$PIDFILE" ] && kill $(cat "$PIDFILE") 2>/dev/null && rm -f "$PIDFILE"
    echo "🛑 Stopped"
}

status() {
    [ -f "$PIDFILE" ] && echo "✅ Running" || echo "❌ Stopped"
}

case "$1" in
    add) add_project ;;
    start) start ;;
    stop) stop ;;
    status) status ;;
    *)
        echo "CYBRA CLUSTER AI"
        echo "add | start | stop | status"
        ;;
esac
