#!/data/data/com.termux/files/usr/bin/bash

# CYBRA CLUSTER MODE

BASE="$HOME/.cybra_cluster"
PROJECTS="$BASE/projects.list"
STATE_DIR="$BASE/state"
PIDFILE="$BASE/pid"

mkdir -p "$BASE"
mkdir -p "$STATE_DIR"

load_config() {
    source "$HOME/.cybra_config" 2>/dev/null || {
        echo "❌ Run: cybra-auto init first"
        exit 1
    }
}

add_project() {
    echo "📂 Path to project:"
    read path

    echo "📦 Repo name:"
    read repo

    echo "$path|$repo" >> "$PROJECTS"

    echo "✅ Added to cluster"
}

list_projects() {
    echo "📦 Cluster projects:"
    cat "$PROJECTS" 2>/dev/null
}

hash_project() {
    path="$1"

    find "$path" -type f \
    -not -path "*/node_modules/*" \
    -not -path "*/.git/*" \
    -exec sha256sum {} \; 2>/dev/null | sha256sum | awk '{print $1}'
}

sync_project() {
    path="$1"
    repo="$2"

    cd "$path" || return

    [ -d ".git" ] || git init

    git branch -M main

    git remote remove origin 2>/dev/null
    git remote add origin https://github.com/$USER/$repo.git 2>/dev/null

    git add .

    if git diff --cached --quiet; then
        return
    fi

    HASH=$(hash_project "$path")

    STATE_FILE="$STATE_DIR/$(echo "$repo" | tr '/' '_')"

    LAST=""
    [ -f "$STATE_FILE" ] && LAST=$(cat "$STATE_FILE")

    [ "$HASH" = "$LAST" ] && return

    git commit -m "cluster: $HASH"

    git push https://$USER:$TOKEN@github.com/$USER/$repo.git main

    echo "$HASH" > "$STATE_FILE"

    echo "🚀 $repo synced"
}

cluster_loop() {
    echo "🧬 CYBRA CLUSTER RUNNING..."

    while true; do

        while IFS="|" read -r path repo; do
            [ -z "$path" ] && continue
            sync_project "$path" "$repo"
        done < "$PROJECTS"

        sleep 10
    done
}

start() {
    load_config

    if [ -f "$PIDFILE" ]; then
        echo "⚠️ Cluster already running"
        exit 0
    fi

    nohup bash -c "cluster_loop" >/dev/null 2>&1 &
    echo $! > "$PIDFILE"

    echo "✅ Cluster started"
}

stop() {
    if [ -f "$PIDFILE" ]; then
        kill $(cat "$PIDFILE") 2>/dev/null
        rm -f "$PIDFILE"
        echo "🛑 Cluster stopped"
    else
        echo "⚠️ Not running"
    fi
}

status() {
    if [ -f "$PIDFILE" ]; then
        echo "✅ Cluster running (PID $(cat $PIDFILE))"
    else
        echo "❌ Cluster stopped"
    fi
}

case "$1" in
    add) add_project ;;
    list) list_projects ;;
    start) start ;;
    stop) stop ;;
    status) status ;;
    *)
        echo "CYBRA CLUSTER"
        echo "add | list | start | stop | status"
        ;;
esac
